{
  "name": "@tscircuit/point-breakout-solver",
  "version": "0.1.0",
  "description": "Clearance-aware octilinear routing from interior points to a rectangular boundary.",
  "module": "lib/index.ts",
  "type": "module",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/point-breakout-solver.git"
  },
  "homepage": "https://point-breakout-solver.vercel.app",
  "keywords": [
    "autorouter",
    "breakout-routing",
    "geometry",
    "octilinear",
    "tscircuit"
  ],
  "scripts": {
    "start": "cosmos",
    "dev": "cosmos",
    "build:site": "cosmos-export",
    "build": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "benchmark": "bun benchmarks/run-benchmark.ts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/solver-utils": "0.0.19",
    "graphics-debug": "0.0.96"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-cosmos": "7.3.0",
    "react-cosmos-plugin-vite": "7.3.0",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
